#. Plugin Name of the plugin
#: multilify.php includes/class-multilify.php:281
msgid "Multilify"
msgstr "Multilify"

#. Plugin URI of the plugin
#: multilify.php
msgid "https://multilify.com"
msgstr "https://multilify.com"

#. Description of the plugin
#: multilify.php
msgid ""
"A powerful multilingual content management system for WordPress. Supports "
"unlimited languages with custom slugs, SEO optimization, and performance "
"caching."
msgstr ""
"WordPress için güçlü, çok dilli bir içerik yönetim sistemi. Sınırsız dil, "
"her dil için özel adres son eki, SEO iyileştirmesi ve başarım için "
"önbellekleme sunar."

#. Author of the plugin
#: multilify.php
msgid "Kadir Erman"
msgstr "Kadir Erman"

