#. Plugin Name of the plugin
#: multilify.php includes/class-multilify.php:281
msgid "Multilify"
msgstr "Multilify"

#. Plugin URI of the plugin
#: multilify.php
msgid "https://multilify.com"
msgstr "https://multilify.com"

#. Description of the plugin
#: multilify.php
msgid ""
"A powerful multilingual content management system for WordPress. Supports "
"unlimited languages with custom slugs, SEO optimization, and performance "
"caching."
msgstr ""
"Ein leistungsstarkes mehrsprachiges Content-Management-System für WordPress. "
"Unterstützt beliebig viele Sprachen mit eigenen Titelformen, SEO-Optimierung "
"und Caching für schnelle Seiten."

#. Author of the plugin
#: multilify.php
msgid "Kadir Erman"
msgstr "Kadir Erman"

#. Author URI of the plugin
#: multilify.php
msgid "https://kadirerman.com"
msgstr "https://kadirerman.com"

